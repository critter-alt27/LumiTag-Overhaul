{
  "name": "lumitag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dedicated tag manager extension for Lumiverse characters.",
  "scripts": {
    "build:backend": "bun build src/backend.ts --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.ts --outfile dist/frontend.js --target browser",
    "build": "bun run build:backend && bun run build:frontend",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "lumiverse-spindle-types": "0.6.39"
  }
}